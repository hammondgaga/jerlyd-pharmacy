# Copy to `.env.local` for local development (never commit real secrets).

# Postgres — create a free database at https://neon.tech and paste the connection string.
# This app uses @neondatabase/serverless; Neon URLs work out of the box on Vercel.
DATABASE_URL=

# Signing key for session tokens (minimum 16 characters).
JWT_SECRET=change-this-to-a-long-random-string

# Transactional email (Resend) — welcome + password reset
# https://resend.com — verify your sending domain, then use e.g. Jerlyd Pharmacy <noreply@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=
# Public site URL for links in emails (defaults to https://VERCEL_URL on Vercel)
APP_URL=
NEXT_PUBLIC_APP_URL=

# Patients register without this. Pharmacists must enter this exact value when creating a staff account.
PHARMACIST_INVITE_CODE=jerlyd-staff-invite-change-me

# --- Deploy to Vercel (summary) ---
# 1. Push this repo to GitHub (or use `vercel` CLI from this folder).
# 2. Vercel → New Project → import repo; Framework Preset: Next.js.
# 3. Add DATABASE_URL, JWT_SECRET (16+ chars), and PHARMACIST_INVITE_CODE for Production (and Preview if you test there).
# --- Step 3: create tables (pick ONE) ---
#
# A) Neon only (no Node CLI): open Neon → SQL Editor → paste scripts/neon-init-once.sql (first time),
#    then scripts/neon-init-v2.sql for feedback replies + stock/orders (if you already ran v1),
#    then scripts/neon-init-v3.sql for marketplace prices, USDC payments, and wallet addresses.
#
# Arc testnet USDC (patient checkout): treasury wallet that receives payments.
PHARMACY_USDC_WALLET=
NEXT_PUBLIC_PHARMACY_USDC_WALLET=
# Optional — defaults to https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_URL=
#
# B) From this folder on your PC: copy the same DATABASE_URL you use on Vercel into .env.local, then:
#    npm install
#    npm run db:migrate
#
# C) Same .env.local as (B), then: npm run db:push
#
# If you used (A), do not also run db:migrate for the same schema (tables already exist).
# 4. Open the Vercel URL: patients register under Patient portal; pharmacists register once using your invite code.
